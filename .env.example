# ============================================================
# QwenKB — 本地环境变量配置
# 复制本文件为 .env，按你的环境修改后使用
# ⚠  .env 已加入 .gitignore，不会提交到 Git
# ============================================================

# ----- LM Studio 嵌入服务 -----
EMBEDDING_API_URL=http://127.0.0.1:5000/v1/embeddings
EMBEDDING_API_KEY=你的LMStudioKey
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
EMBEDDING_DIM=2560

# ----- ChromaDB Server -----
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=9898

# ----- MCP Server -----
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8766

# ----- 重排（Rerank，可选） -----
# 不启用: RERANK_ENABLED=false
# 本地 BGE: 启动 python rerank_server.py 后使用默认 URL
# 云端: 填入服务商 URL + API Key
RERANK_ENABLED=true
RERANK_API_URL=http://127.0.0.1:5001
RERANK_API_KEY=

# ----- DeepSeek API（opencode 后端用） -----
DEEPSEEK_API_KEY=你的DeepSeekKey
