# ============================================================
# Ezy-RAG V0.0.14 — 环境配置模板
# 复制此文件为 .env 并填入你的实际配置
# ============================================================

# ----- Embedding 模型配置 -----
# 嵌入服务地址（如 LM Studio、OpenAI 等）
EMBEDDING_API_URL=http://127.0.0.1:5000/v1/embeddings
# 嵌入服务密钥（可选，本地服务通常不需要）
EMBEDDING_API_KEY=
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# 嵌入向量维度（根据模型调整）
EMBEDDING_DIM=2560

# ----- Rerank 模型配置 -----
# 是否启用重排（true/false）
RERANK_ENABLED=true
# 重排服务地址（本地或云端）
RERANK_API_URL=http://127.0.0.1:5001
# 重排服务密钥（可选）
RERANK_API_KEY=

# ----- ChromaDB 服务配置 -----
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=9898

# ----- MCP 服务配置 -----
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=9766

# ----- 切块策略 -----
# 可选: academic(英文文献) chinese(中文专用) code(代码专用) custom(自定义)
CHUNK_TEMPLATE=academic
