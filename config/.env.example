# ============================================================
# Ezy-RAG V0.0.17 — 环境配置模板
# 复制此文件为 .env 并填写实际配置
# ============================================================

# ----- Embedding 模型配置 -----
# 模式：local（本地 LM Studio/Ollama）/ cloud（云端 API）
EMBEDDING_MODE=cloud

# 云端模式配置（openai/siliconflow/deepseek/zhipu/moonshot/custom）
EMBEDDING_CLOUD_PROVIDER=siliconflow
EMBEDDING_CLOUD_API_KEY=your-api-key-here
EMBEDDING_CLOUD_MODEL=BAAI/bge-m3
EMBEDDING_CLOUD_DIM=1024
EMBEDDING_CLOUD_URL=

# 本地模式配置（LM Studio/Ollama 等）
EMBEDDING_LOCAL_URL=http://127.0.0.1:1234/v1/embeddings
EMBEDDING_LOCAL_MODEL=text-embedding-qwen3-embedding-4b
EMBEDDING_LOCAL_DIM=2560

# ----- Rerank 模型配置 -----
# 是否启用 Rerank
RERANK_ENABLED=true

# 模式：local（本地 CrossEncoder）/ cloud（云端 API）
RERANK_MODE=cloud

# 云端模式配置（cohere/jina/custom）
RERANK_CLOUD_PROVIDER=cohere
RERANK_CLOUD_API_KEY=your-api-key-here
RERANK_CLOUD_MODEL=rerank-multilingual-v3.0
RERANK_CLOUD_URL=

# 本地模式配置
RERANK_LOCAL_URL=http://127.0.0.1:5001

# ----- ChromaDB 服务配置 -----
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=9898

# ----- MCP 服务配置 -----
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=9766

# ----- 切块策略 -----
CHUNK_TEMPLATE=academic
