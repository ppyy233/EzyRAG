# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE
.idea/

# Logs
*.log

# Data (ignore all except placeholder)
data/docs/*
!data/docs/.gitkeep
data/chroma_db/*
!data/chroma_db/.gitkeep
data/models/*
!data/models/.gitkeep

# Environment variables (contains real API keys)
.env
config/.env

# Runtime generated files
runtime/logs/*
!runtime/logs/.gitkeep
runtime/state/*
!runtime/state/.gitkeep

# Backup files
*.backup

frontend/node_modules/
