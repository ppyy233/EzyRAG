# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Data (ignore all except placeholder)
data/docs/*
!data/docs/.gitkeep
data/web/*
!data/web/.gitkeep
data/chroma_db/*
!data/chroma_db/.gitkeep
data/models/*
!data/models/.gitkeep

# Environment variables (contains real API keys)
.env
config/.env

# Runtime generated files
runtime/logs/*
runtime/state/*
!runtime/logs/.gitkeep
!runtime/state/.gitkeep

# Downloaded model files
models/

# Backup files
*.backup
*.bak

# Test reports
tests/*.json
!tests/.gitkeep

# uv lock file (optional, uncomment if not needed)
# uv.lock

# OS generated files
.DS_Store
Thumbs.db
